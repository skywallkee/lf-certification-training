# Postgres with the curriculum, content and app tables (pnpm db:migrate, pnpm curriculum:ingest).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lfct
# Better Auth: a random secret of at least 32 characters, and the public base URL.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-0123456789
BETTER_AUTH_URL=http://localhost:3000
# Optional: GitHub sign-in. The button is hidden when these are empty.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Emails that get the admin role when their account is created (comma-separated).
ADMIN_EMAILS=
# Email. Without SMTP_URL, messages only go to the outbox_email table and the server log. For a local inbox, run
# Mailpit (docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit:v1.33.0) and uncomment these:
# SMTP_URL=smtp://localhost:1025
# MAIL_INBOX_URL=http://localhost:8025
# MAIL_FROM=LF Cert Trainer <no-reply@lfct.localhost>
# Development only: show the emailed link (verification, password reset) on the check-your-email pages.
SHOW_DEV_EMAILS=true
