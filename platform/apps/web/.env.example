# Postgres with the curriculum, content and app tables (pnpm db:migrate, pnpm curriculum:ingest).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lfct
# Better Auth: a random secret of at least 32 characters, and the public base URL.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-0123456789
BETTER_AUTH_URL=http://localhost:3000
# Optional: GitHub sign-in. The button is hidden when these are empty.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Emails that get the admin role when their account is created (comma-separated).
ADMIN_EMAILS=
# Development only: show verification links on the verify page (no mail provider in Phase 1).
SHOW_DEV_EMAILS=true
