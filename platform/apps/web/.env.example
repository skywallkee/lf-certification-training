# Postgres with the curriculum, content and app tables (pnpm db:migrate, pnpm curriculum:ingest).
DATABASE_URL=postgres://postgres:postgres@localhost:4432/lfct
# Better Auth: a random secret of at least 32 characters, and the public base URL.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-0123456789
BETTER_AUTH_URL=http://localhost:4000
# Optional: GitHub sign-in. The button is hidden when these are empty.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Emails that get the admin role when their account is created (comma-separated).
ADMIN_EMAILS=
# Optional: send email over SMTP (for example a local Mailpit: docker compose up mailpit, then smtp://localhost:4026).
# Without it, emails only go to the outbox_email table and the log.
SMTP_URL=
MAIL_FROM=
MAIL_INBOX_URL=
# Development only: show verification links on the verify page.
SHOW_DEV_EMAILS=true
