# Copy to .env to change the local Docker stack's settings. Every value has a working default.
# Hosting it on a server for others? Run scripts/selfhost-init.sh instead (see docs/self-hosting.md).

# Ports on 127.0.0.1
# WEB_PORT=4000
# LAB_CONTROLLER_PORT=4001
# POSTGRES_PORT=4432
# MAILPIT_PORT=4025               local test inbox for app emails
# MAILPIT_SMTP_PORT=4026          its SMTP port, for `pnpm dev` on the host
# NARRATOR_PORT=4880             lesson video narrator, for `pnpm dev` on the host

# The URL the browser uses. It follows WEB_PORT; set it only for another host name:
# APP_URL=http://localhost:4000

# Secrets. The defaults are fine on your own machine; set long random values anywhere else.
# BETTER_AUTH_SECRET=
# LAB_CONTROLLER_SECRET=
# LAB_TOKEN_SECRET=
# POSTGRES_PASSWORD=postgres

# Optional GitHub sign-in (the button is hidden when empty)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email. By default every email goes to the local Mailpit inbox at http://localhost:4025.
# To send real mail, point SMTP_URL at your provider (smtps:// for TLS) and set a sender it accepts.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM=LF Cert Trainer <no-reply@example.com>

# Labs
# LAB_MONTHLY_MINUTES=600          lab allowance per learner per month
# LAB_MAX_ACTIVE_SESSIONS=3        concurrent labs and mock attempts on this machine; more learners wait in line
# LAB_MAX_CLUSTERS=                concurrent clusters in all (a 3-cluster mock counts 3; each k3s needs about 600 MB)
# LAB_PROVIDER=docker              "fake" runs labs without Docker (no real cluster; type "solve" in the terminal)
# LAB_K3S_IMAGE=rancher/k3s:v1.34.13-k3s1
# LAB_DOCS_HOSTS=kubernetes.io,helm.sh   documentation sites the lab player's docs tab may show
# LAB_IMAGE_CACHE=true             save preloaded images once (volume lfct-image-cache) so k3s imports them at boot

# Practical mock exams: attempts per learner, per cert, per calendar month (only started attempts count)
# MOCK_EXAMS_PER_MONTH=2
# MOCK_PRACTICE_PER_MONTH=2
# Study reminder emails (weekly plan, nudges, exam countdown; learners opt in under Account): minutes between
# checks for due reminders, 0 turns them off. REMINDERS_SECRET is only for an outside scheduler calling
# POST /api/reminders/run; without it the token is derived from BETTER_AUTH_SECRET.
# REMINDERS_INTERVAL_MINUTES=10
# REMINDERS_SECRET=

# Lesson video narration by the local narrator service (Kokoro text to speech). Empty = the browser's own voice.
# NARRATOR_URL=http://narrator:8880

# Sample learners: if-missing (default) keeps your progress, always resets them, never skips them
# SEED=if-missing

# Database backups (into ./backups; see the README). 0 turns the automatic ones off.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7                    automatic backups to keep (on-demand ones are never deleted)
# BACKUP_UID=1000                  your user and group ids (`id -u`, `id -g`), so the files are yours
# BACKUP_GID=1000

# Docker socket, if yours is elsewhere (rootless Docker, Colima, ...)
# DOCKER_SOCKET=/var/run/docker.sock

# Builds behind a TLS-inspecting proxy: path to its CA bundle
# EXTRA_CA_FILE=
