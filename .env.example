# Copy to .env to change the local Docker stack's settings. Every value has a working default.

# Ports on 127.0.0.1
# WEB_PORT=3000
# LAB_CONTROLLER_PORT=3001
# POSTGRES_PORT=5432

# If you change WEB_PORT, set the URL the browser uses:
# APP_URL=http://localhost:3000

# Secrets. The defaults are fine on your own machine; set long random values anywhere else.
# BETTER_AUTH_SECRET=
# LAB_CONTROLLER_SECRET=
# LAB_TOKEN_SECRET=
# POSTGRES_PASSWORD=postgres

# Optional GitHub sign-in (the button is hidden when empty)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Labs
# LAB_MONTHLY_MINUTES=600          lab allowance per learner per month
# LAB_MAX_ACTIVE_SESSIONS=3        concurrent labs on this machine (each k3s needs about 600 MB of RAM)
# LAB_PROVIDER=docker              "fake" runs labs without Docker (no real cluster; type "solve" in the terminal)
# LAB_K3S_IMAGE=rancher/k3s:v1.34.13-k3s1
# LAB_DOCS_HOSTS=kubernetes.io,helm.sh   documentation sites the lab player's docs tab may show

# Practical mock exams: attempts per learner, per cert, per calendar month (only started attempts count)
# MOCK_EXAMS_PER_MONTH=2
# MOCK_PRACTICE_PER_MONTH=2

# Sample learners: if-missing (default) keeps your progress, always resets them, never skips them
# SEED=if-missing

# Docker socket, if yours is elsewhere (rootless Docker, Colima, ...)
# DOCKER_SOCKET=/var/run/docker.sock

# Builds behind a TLS-inspecting proxy: path to its CA bundle
# EXTRA_CA_FILE=
