{
  "title": "Certification curriculum",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{2,6}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "examStyle": {
      "type": "string",
      "enum": [
        "performance",
        "multiple-choice"
      ]
    },
    "durationMinutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "curriculum": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "cncf-curriculum"
                },
                "repo": {
                  "type": "string",
                  "const": "cncf/curriculum"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "blobSha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              },
              "required": [
                "kind",
                "repo",
                "commit",
                "path",
                "blobSha"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "web"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "kind",
                "url"
              ],
              "additionalProperties": false
            }
          ]
        },
        "retrievedAt": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "effectiveFrom": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "verification": {
          "type": "string",
          "enum": [
            "text",
            "visual",
            "pending"
          ]
        }
      },
      "required": [
        "source",
        "retrievedAt",
        "verification"
      ],
      "additionalProperties": false
    },
    "examTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domains": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "competencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "key",
                "statement"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "key",
          "name",
          "weight",
          "competencies"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "code",
    "name",
    "examStyle",
    "curriculum",
    "domains"
  ],
  "additionalProperties": false
}
